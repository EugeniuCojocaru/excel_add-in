{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "esmodules": false
        }
      }
    ],
    ["@babel/preset-react", { "runtime": "automatic" }]
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./src"],
        "alias": {
          "@i18n": "./src/libraries/i18n",
          "@math": "./src/libraries/math",
          "@econometrics": "./src/libraries/econometrics",
          "@excel": "./src/libraries/excel",
          "@constants": "./src/libraries/constants"
        }
      }
    ],
    "@babel/plugin-proposal-export-namespace-from"
  ]
}
