{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "esmodules": false
        }
      }
    ],
    ["@babel/preset-react", { "runtime": "automatic" }]
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./src"],
        "alias": {
          "@utils": "./src/libraries/utils",
          "@i18n": "./src/libraries/i18n",
          "@api": "./src/libraries/api"
        }
      }
    ],
    "@babel/plugin-proposal-export-namespace-from"
  ]
}
